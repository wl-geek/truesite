# What `gcloud run deploy --source .` uploads to Cloud Build. Without this file
# gcloud derives one from .gitignore -- which would silently drop any
# git-ignored file the build needs (e.g. generated model.glb in web/public).
.gcloudignore
.git
.gitignore
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
web/dist/
docs/
brand/
.env
.env.*
# Mirrors the private bits of .gitignore. Don't include .gitignore itself: it would drop
# web/public/sheets, which deploy renders for the service URL and the image must contain.
*.pem
*-key.json
service-account*.json
*.log
capture/
.playwright-mcp/
.cache/
bim/sheets/
