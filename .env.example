# TrueSite server settings: every environment variable the server reads, with safe local values.
#
# Nothing here is a secret, and nothing secret belongs in a file in this repository. On Cloud Run,
# infra/gcloud.sh sets these as plain environment variables; Gemini and Google Cloud are reached with the
# runtime service account (Application Default Credentials), so production holds no API key at all.
#
# Local use: copy to .env (git-ignored) and load it, e.g. from server/:
#   uv run --env-file ../.env uvicorn --factory app.main:create_app --reload --port 8000
# With no variables set at all, the server runs offline: fake Gemini, in-memory store.

# ---- Where things are ----------------------------------------------------------------------------------------
# The built web app (Vite dist/) and the BIM models. Defaults: web/dist and bim/models in the repo.
# In the container: /app/static and /app/models (set by the Dockerfile).
STATIC_DIR=
MODELS_DIR=

# ---- Gemini ----------------------------------------------------------------------------------------------------
# fake: offline, deterministic stand-in (tests, local dev). live: real Gemini through google-genai.
GEMINI_MODE=fake
# Live Gemini on Agent Platform through Application Default Credentials (production; locally:
# `gcloud auth application-default login`). The model is served from the global endpoint.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional fallback only: a Gemini Developer API key instead of Agent Platform. Never put a real key in a
# file: in production it comes from the Secret Manager secret gemini-api-key (GEMINI_BACKEND=apikey make deploy),
# which also sets GOOGLE_GENAI_USE_ENTERPRISE=false. Locally, export it in your shell for one session.
# GEMINI_API_KEY=
# Models tried in order when the main one is overloaded or out of quota; empty turns the fallback off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# 1: add the extra "judge each element at its own outline" guidance to the check prompt.
CHECK_PROMPT_FOCUS=0
# 1: a close-up second look at flagged, thin and small marks (server/app/verify.py); deploy turns it on.
CHECK_VERIFY=0
# Which changes the second look may make: both, downgrade (only clear flags) or upgrade (only add them).
CHECK_VERIFY_POLICY=both
# How the second look runs (config.VerifySettings): its model (empty: the check's own; Flash-Lite was faster but
# cleared real defects, 26 Nov), each close-up's limit and the most it waits after the first pass (ms), how many thin
# or small and how many flagged marks get a close-up, how many run at once, and the photo crops' media resolution.
VERIFY_MODEL=
VERIFY_TIMEOUT_MS=14000
VERIFY_GRACE_MS=6000
VERIFY_MAX_QUIET=16
VERIFY_MAX_LATE=10
VERIFY_WORKERS=16
VERIFY_PHOTO_RESOLUTION=high
# 1: a check of a shipped sample photo refreshes its saved result (the fallback). Off on the deployed service;
# refresh from a local server with STORE_BACKEND=gcp and SAVE_SAMPLE_RESULTS=1 (/samples?photos&dev=1, Run all).
SAVE_SAMPLE_RESULTS=0

# ---- Storage ---------------------------------------------------------------------------------------------------
# memory: in-process (tests, local dev). gcp: Firestore + Cloud Storage through Application Default Credentials.
STORE_BACKEND=memory
# Needed when STORE_BACKEND=gcp: the private upload bucket (infra/gcloud.sh names it <project>-uploads).
GCS_BUCKET=
FIRESTORE_DATABASE="(default)"

# ---- Upload limits ---------------------------------------------------------------------------------------------
# Bytes per image, bytes per whole request, and width x height per image.
MAX_UPLOAD_BYTES=4194304
MAX_BODY_BYTES=13631488
MAX_IMAGE_PIXELS=4000000

# ---- Abuse limits ----------------------------------------------------------------------------------------------
# Per client IP per hour (per instance), and daily caps across all users (UTC day, kept in the store).
CHECKS_PER_IP_PER_HOUR=10
ASKS_PER_IP_PER_HOUR=30
DAILY_CHECK_CAP=300
DAILY_ASK_CAP=1000
ISSUES_PER_IP_PER_HOUR=30
ISSUES_PER_SESSION=100
# Confirm or dismiss decisions on the Checks page, per client IP.
REVIEWS_PER_IP_PER_HOUR=300
# How many proxies append to X-Forwarded-For: 1 for a direct *.run.app URL, 2 behind an HTTPS load balancer.
TRUSTED_PROXY_HOPS=1

# ---- Development -----------------------------------------------------------------------------------------------
# 1: Swagger UI at /api/docs (make dev-server sets it). Keep it off in production.
API_DOCS=0
# Recorded in each check's audit trail; `make deploy` sets the deployed commit.
APP_VERSION=dev
